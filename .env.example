# ==============================================================================
# AI-Powered CRM & Outreach Automation Platform - Environment Variables
# Copy this file to .env before starting services: cp .env.example .env
# NEVER COMMIT .env TO GIT. KEEP ALL REAL KEYS SECRET!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development               # development | staging | production
HOST=0.0.0.0
PORT=8000
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-super-secret-random-key-in-development-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://staging.outreach-crm.internal

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon PostgreSQL Free Tier)
# Direct connection string with psycopg. Connection pooling is managed by psycopg_pool.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://crm_user:password@ep-cool-sample.us-east-2.aws.neon.tech/crm_db?sslmode=require
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=5
DB_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 3. WEBHOOK & INTERNAL API SECURITY
# ------------------------------------------------------------------------------
SCRAPER_INGEST_SECRET=replace-with-secure-scraper-ingest-secret-token
PROVIDER_WEBHOOK_SECRET=replace-with-secure-hmac-webhook-secret-token

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (Gemini Flash Model)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MOCK_MODE=true                 # Set to false to use live Gemini API calls

# -----------------------------------------------------------------------------
# 5. CONTACT ENRICHMENT PROVIDERS (ContactOut & Snov.io)
# ------------------------------------------------------------------------------
CONTACTOUT_API_KEY=your-contactout-api-key
SNOV_API_KEY=your-snov-api-key
CONTACTOUT_SANDBOX=true
DAILY_CREDIT_BUDGET=50
MONTHLY_CREDIT_BUDGET=1000

# ------------------------------------------------------------------------------
# 6. EMAIL VERIFICATION PROVIDER
# ------------------------------------------------------------------------------
EMAIL_VERIFIER_PROVIDER=hunter        # Options: hunter | debounce | mock
EMAIL_VERIFIER_API_KEY=your-email-verifier-api-key
EMAIL_VERIFIER_SANDBOX=true

# ------------------------------------------------------------------------------
# 7. EMAIL OUTREACH DISPATCH PROVIDER
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend                 # Options: resend | sendgrid | mock
EMAIL_PROVIDER_API_KEY=your-email-provider-api-key
EMAIL_FROM_ADDRESS=outreach@company.example.com
EMAIL_SANDBOX_MODE=true               # Staging & local sends ONLY to sandbox addresses
DAILY_SEND_LIMIT=100

# ------------------------------------------------------------------------------
# 8. SCRAPERS & AUTOMATION CONFIGURATION
# ------------------------------------------------------------------------------
MAX_PLAYWRIGHT_CONCURRENCY=2
SCRAPER_TIMEOUT_SECONDS=60
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# ------------------------------------------------------------------------------
# 9. FRONTEND CONFIGURATION (Vite React Dashboard)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=true                   # Set to false to point frontend to real backend API
